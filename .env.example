# Copy this file to .env for local development and replace the placeholders.
# Use only the public Supabase project URL and anon/publishable key.
# Never put service_role or any secret key in a VITE_* variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
